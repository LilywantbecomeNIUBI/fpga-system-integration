// ADC-remap candidate; unplug ADC digital connector. Not a complete downloadable project.
// P7-36/37 require old carrier lidar UART disconnected. Encoder inputs require 3.3V conditioning.
// P7-36 level shifter <- E2B / D157B J5-4
IO_LOC "right_enc_b" D19;
IO_PORT "right_enc_b" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
// P7-37 external safety status / external pulldown
IO_LOC "estop_n" F18;
IO_PORT "estop_n" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
// P7-21 AIN1 / D157B J4-4
IO_LOC "left_in1" D17;
IO_PORT "left_in1" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
// P7-22 AIN2 / D157B J4-3
IO_LOC "left_in2" C17;
IO_PORT "left_in2" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
// P7-23 BIN1 / D157B J4-2
IO_LOC "right_in1" E16;
IO_PORT "right_in1" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
// P7-24 BIN2 / D157B J4-1
IO_LOC "right_in2" D16;
IO_PORT "right_in2" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
// P7-25 level shifter <- E1A / D157B J5-1
IO_LOC "left_enc_a" B17;
IO_PORT "left_enc_a" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
// P7-26 level shifter <- E1B / D157B J5-2
IO_LOC "left_enc_b" B18;
IO_PORT "left_enc_b" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
// P7-27 level shifter <- E2A / D157B J5-3
IO_LOC "right_enc_a" C18;
IO_PORT "right_enc_a" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
